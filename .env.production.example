# NewsForge PRODUCTION environment template (PRODUCTION_SECRETS_AND_DEPLOYMENT).
# Copy the VALUES below into your secret provider / platform env; NEVER commit
# this file with real credentials, and NEVER bake it into a Docker image.
#
# A production process REFUSES to start unless the fail-fast configuration gate
# passes (tests/dev/staging are never gated). Required in production:
#   * NEWSFORGE_ENVIRONMENT=production
#   * NEWSFORGE_DATABASE_URL (PostgreSQL only — SQLite is refused)
#   * NEWSFORGE_ADMIN_TOKEN (a strong random value)
#   * NEWSFORGE_MOCK_AI=false + a real provider + its API key (OpenAI)
#   * NEWSFORGE_SITE_URL as a public https URL

# --- Environment ------------------------------------------------------------
NEWSFORGE_ENVIRONMENT=production

# --- Database (PostgreSQL ONLY; +pg8000 is the pure-Python driver) ----------
# Replace every value; passwords come from the secret provider, never this file.
NEWSFORGE_DATABASE_URL=postgresql+pg8000://USER:CHANGE-ME@DB-HOST:5432/newsforge
# Offline backup location: persistent volume, NEVER contains secrets.
NEWSFORGE_BACKUP_DIR=/data/backups

# --- Admin / internal endpoints (/analytics, /metrics) ----------------------
# Strong random value (e.g. `python -c "import secrets;print(secrets.token_urlsafe(32))"`).
NEWSFORGE_ADMIN_TOKEN=CHANGE-ME

# --- AI (real provider required; MOCK is refused in production) --------------
NEWSFORGE_MOCK_AI=false
NEWSFORGE_DEFAULT_PROVIDER=openai
NEWSFORGE_OPENAI_API_KEY=CHANGE-ME
NEWSFORGE_AI_TIMEOUT_S=30
NEWSFORGE_AI_MAX_TOKENS=500

# --- Brand / public ---------------------------------------------------------
NEWSFORGE_SITE_URL=https://newsforge.example
NEWSFORGE_BRAND_NAME=Lumen
NEWSFORGE_TAGLINE="Verified light on what matters."
NEWSFORGE_ADMIN_TITLE=NewsForge Admin

# --- Server ---------------------------------------------------------------
NEWSFORGE_HOST=0.0.0.0
NEWSFORGE_PORT=8000
NEWSFORGE_DEBUG=false

# --- Build identity (set by the image/CI; never a password) ------------------
# NEWSFORGE_VERSION=0.1.0
# NEWSFORGE_GIT_COMMIT=<sha>
# NEWSFORGE_BUILD_TIME=<iso timestamp>