# NewsForge Staging Environment Configuration Template
# Copy this file as .env.staging and configure for your staging environment
# NEVER commit .env.staging with real credentials

# Database configuration
NEWSFORGE_DB_PATH=/data/newsforge.db
# In production: set to absolute path on volume mount

# Offline backup location (created by newsforge.db.backup / restore procedure).
NEWSFORGE_BACKUP_DIR=/data/backups

# AI Provider - MOCK MODE FOR STAGING (recommended)
NEWSFORGE_MOCK_AI=true
# To use real provider, set false and configure one below:
# NEWSFORGE_DEFAULT_PROVIDER=openai  # or ollama
# NEWSFORGE_OPENAI_API_KEY=your-real-api-key-here

# Application configuration
NEWSFORGE_SITE_URL=http://localhost:8000
NEWSFORGE_BRAND_NAME=Lumen
NEWSFORGE_TAGLINE="Verified light on what matters."
NEWSFORGE_ADMIN_TITLE=NewsForge Staging

# Server settings
NEWSFORGE_HOST=0.0.0.0
NEWSFORGE_PORT=8000

# Internal BI endpoints (/analytics) are FAIL-CLOSED: set NEWSFORGE_ADMIN_TOKEN to a
# strong random value to enable them. Never use a real production secret here.
# NEWSFORGE_ADMIN_TOKEN=change-me

# Optional: enable SQL logging for debugging (set to false in production)
NEWSFORGE_ECHO_SQL=false

# Optional: set different timeouts for long-running operations
# NEWSFORGE_TIMEOUT_MS=30000

# Optional: log level (debug, info, warning, error)
# LOG_LEVEL=info

# IMPORTANT SECURITY NOTES:
# - Never commit this file with real API keys
# - Use secrets manager for production credentials
# - Set MOCK_AI=false only when testing with real providers
# - Rotate API keys regularly in production environment