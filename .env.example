# NewsForge Environment Configuration Template
# Copy this file to .env and configure for production deployment
# NEVER commit .env files - secrets should come from secure environment management

# Database configuration
NEWSFORGE_DB_PATH=./data/newsforge.db
# NEWSFORGE_DB_PATH=/path/to/production/db.sqlite  # Use absolute path in Docker

# AI Provider settings (MOCK mode for offline deployment)
NEWSFORGE_MOCK_AI=true
# Set to false and configure one of the following providers:
# NEWSFORGE_DEFAULT_PROVIDER=openai
# NEWSFORGE_OPENAI_API_KEY=your-api-key-here
# OR use local models:
# NEWSFORGE_DEFAULT_PROVIDER=ollama
# NEWSFORGE_OLLAMA_URL=http://localhost:11434

# Application settings
NEWSFORGE_SITE_URL=http://localhost:8000
NEWSFORGE_BRAND_NAME=Lumen
NEWSFORGE_TAGLINE="Verified light on what matters."
NEWSFORGE_ADMIN_TITLE=NewsForge Admin
NEWSFORGE_ECHO_SQL=false

# Server settings
NEWSFORGE_HOST=0.0.0.0
NEWSFORGE_PORT=8000
# NEWSFORGE_DEBUG=false

# Internal BI endpoints (/analytics) are FAIL-CLOSED: set NEWSFORGE_ADMIN_TOKEN to a
# strong random value to enable them. Never use a real production secret here.
# NEWSFORGE_ADMIN_TOKEN=change-me