# NewsForge Environment Configuration Template
# Copy this file to .env and configure for production deployment
# NEVER commit .env files - secrets should come from secure environment management

# Database configuration
# Relative paths are resolved deterministically against the source root (NOT the process
# cwd); in Docker/pre-production use an absolute path backed by persistent storage.
NEWSFORGE_DB_PATH=./data/newsforge.db
# NEWSFORGE_DB_PATH=/data/newsforge.db  # container: persistent volume
# NEWSFORGE_DB_PATH=postgresql://user:pass@host/db  # dialect swap

# PostgreSQL (authoritative DSN when set; takes precedence over NEWSFORGE_DB_PATH and is
# NEVER coerced to a filesystem Path). Passwords are always redacted in logs/reports.
# The +pg8000 driver is pure-Python (no native libpq); add it to your runtime deps.
# NEWSFORGE_DATABASE_URL=postgresql+pg8000://newsforge:CHANGE-ME@localhost:5432/newsforge

# Environment gate. Production refuses to boot against SQLite, with MOCK_AI=true,
# WITHOUT an ADMIN_TOKEN, with DEBUG on, or with an insecure site_url.
NEWSFORGE_ENVIRONMENT=development

# Offline backup location (created by newsforge.db.backup / the restore procedure).
NEWSFORGE_BACKUP_DIR=./data/backups
# NEWSFORGE_BACKUP_DIR=/data/backups  # container

# AI Provider settings (MOCK mode for offline deployment)
NEWSFORGE_MOCK_AI=true
# Set to false and configure one of the following providers:
# NEWSFORGE_DEFAULT_PROVIDER=openai
# NEWSFORGE_OPENAI_API_KEY=your-api-key-here
# OR use local models:
# NEWSFORGE_DEFAULT_PROVIDER=ollama
# NEWSFORGE_OLLAMA_URL=http://localhost:11434

# Application settings
NEWSFORGE_SITE_URL=http://localhost:8000
NEWSFORGE_BRAND_NAME=Lumen
NEWSFORGE_TAGLINE="Verified light on what matters."
NEWSFORGE_ADMIN_TITLE=NewsForge Admin
NEWSFORGE_ECHO_SQL=false

# Server settings
NEWSFORGE_HOST=0.0.0.0
NEWSFORGE_PORT=8000
# NEWSFORGE_DEBUG=false

# Internal BI endpoints (/analytics) are FAIL-CLOSED: set NEWSFORGE_ADMIN_TOKEN to a
# strong random value to enable them. Never use a real production secret here.
# NEWSFORGE_ADMIN_TOKEN=change-me